---
import { readFileSync } from 'node:fs';
import path from 'node:path';

const svgFile = path.join(process.cwd(), 'public', 'india.svg');
const svgText = readFileSync(svgFile, 'utf-8');
const statePaths: Record<string, string> = {};
const re = /id="([a-z]{2,3})"[^>]*\bd="([^"]+)"/g;
let m: RegExpExecArray | null;
while ((m = re.exec(svgText)) !== null) statePaths[m[1]] = m[2];
---

<div id="map-wrap">
  <svg id="india-svg" viewBox="0 0 612 696" xmlns="http://www.w3.org/2000/svg">
    <g id="state-layer"></g>
    <g id="marker-layer"></g>
  </svg>
</div>

<div id="info-panel">
  <div id="panel-tabs">
    <button class="ptab active" data-tab="overview">Overview</button>
    <button class="ptab" data-tab="pollutants">Pollutants</button>
  </div>
  <div id="panel-back-bar">
    <button id="panel-back">← All States</button>
  </div>
  <div id="panel-scroll">
    <div id="view-overview">
      <div id="panel-hero"></div>
      <div id="panel-categories"></div>
      <div id="panel-list"></div>
    </div>
    <div id="view-pollutants" style="display:none">
      <div id="panel-pollutants"></div>
    </div>
  </div>
  <div id="panel-footer">
    <div id="panel-meta"></div>
    <p class="soi-note">Boundaries shown are for representational purposes only and do not reflect official Survey of India demarcations.</p>
  </div>
</div>

<!-- Hidden spans so updateLegend() doesn't throw if called externally -->
<span id="band-0" class="band-count"></span>
<span id="band-1" class="band-count"></span>
<span id="band-2" class="band-count"></span>
<span id="band-3" class="band-count"></span>
<span id="band-4" class="band-count"></span>
<span id="band-5" class="band-count"></span>

<div id="state-tip"></div>
<div id="popup"><div id="popup-inner"><button id="popup-close">×</button></div></div>
<div id="breathe-tag"><span class="breathe-dot"></span>Know what you breathe.</div>

<script define:vars={{ statePaths }}>
// ── Projection ──
const SVG_W = 612, SVG_H = 696;
const LNG0 = 68.1, LNG1 = 97.4, LAT0 = 6.5, LAT1 = 38.0;
function project(lat, lng) {
  return [(lng - LNG0) / (LNG1 - LNG0) * SVG_W, (LAT1 - lat) / (LAT1 - LAT0) * SVG_H];
}

// ── AQI helpers ──
function aqiColor(aqi) {
  if (aqi <= 50) return '#55A84F'; if (aqi <= 100) return '#A3C853';
  if (aqi <= 200) return '#FFF833'; if (aqi <= 300) return '#F29C33';
  if (aqi <= 400) return '#E93F33'; return '#AF2D24';
}
function aqiLabelColor(hex) {
  const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return (0.299*r + 0.587*g + 0.114*b) / 255 > 0.55 ? '#1a2318' : '#ffffff';
}
function aqiTextColor(aqi) {
  if (aqi <= 50) return '#2d7a27'; if (aqi <= 100) return '#6b8a1c';
  if (aqi <= 200) return '#a07c00'; if (aqi <= 300) return '#c06000';
  if (aqi <= 400) return '#b02010'; return '#7a1208';
}
function aqiVerdict(aqi) {
  if (aqi <= 50) return 'Good'; if (aqi <= 100) return 'Satisfactory';
  if (aqi <= 200) return 'Moderate'; if (aqi <= 300) return 'Poor';
  if (aqi <= 400) return 'Very Poor'; return 'Severe';
}

// ── State IDs ──
const STATE_IDS = {
  an:'andaman and nicobar islands', ap:'andhra pradesh', ar:'arunachal pradesh',
  as:'assam', br:'bihar', ch:'chandigarh', ct:'chhattisgarh',
  dn:'dadra and nagar haveli and daman and diu',
  dl:'delhi', ga:'goa', gj:'gujarat', hr:'haryana', hp:'himachal pradesh',
  jk:'jammu and kashmir', jh:'jharkhand', ka:'karnataka', kl:'kerala',
  ld:'lakshadweep', mp:'madhya pradesh', mh:'maharashtra', mn:'manipur',
  ml:'meghalaya', mz:'mizoram', nl:'nagaland', or:'odisha', py:'puducherry',
  pb:'punjab', rj:'rajasthan', sk:'sikkim', tn:'tamil nadu', tg:'telangana',
  tr:'tripura', up:'uttar pradesh', ut:'uttarakhand', wb:'west bengal',
};
function normState(s) { return (s||'').toLowerCase().replace(/&/g,'and').replace(/\s+/g,' ').trim(); }
const NORM_TO_CODE = Object.fromEntries(Object.entries(STATE_IDS).map(([c, n]) => [n, c]));

// ── DOM refs ──
const svgEl          = document.getElementById('india-svg');
const mapWrap        = document.getElementById('map-wrap');
const stateLayer     = document.getElementById('state-layer');
const markerLayer    = document.getElementById('marker-layer');
const popup          = document.getElementById('popup');
const popupInner     = document.getElementById('popup-inner');
const stateTip       = document.getElementById('state-tip');
const panelBackBar   = document.getElementById('panel-back-bar');
const panelBack      = document.getElementById('panel-back');
const panelHero      = document.getElementById('panel-hero');
const panelCategories = document.getElementById('panel-categories');
const panelList      = document.getElementById('panel-list');
const panelMeta      = document.getElementById('panel-meta');
const bannerEl       = document.getElementById('banner');

// ── Canvas centroid computation ──
const STATE_SVG_CENTROIDS = (() => {
  const map = {};
  const canvas = document.createElement('canvas');
  canvas.width = SVG_W; canvas.height = SVG_H;
  const ctx = canvas.getContext('2d');
  const tmp = document.createElementNS('http://www.w3.org/2000/svg', 'g');
  svgEl.appendChild(tmp);
  Object.entries(statePaths).forEach(([code, d]) => {
    const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    p.setAttribute('d', d); tmp.appendChild(p);
    const bb = p.getBBox();
    tmp.removeChild(p);
    const p2d = new Path2D(d);
    const STEPS = 15;
    let sx = 0, sy = 0, n = 0;
    for (let i = 0; i <= STEPS; i++) {
      for (let j = 0; j <= STEPS; j++) {
        const px = bb.x + bb.width * i / STEPS;
        const py = bb.y + bb.height * j / STEPS;
        if (ctx.isPointInPath(p2d, px, py)) { sx += px; sy += py; n++; }
      }
    }
    map[code] = {
      cx: n > 0 ? sx / n : bb.x + bb.width / 2,
      cy: n > 0 ? sy / n : bb.y + bb.height / 2,
      area: bb.width * bb.height
    };
  });
  svgEl.removeChild(tmp);
  return map;
})();

// Show loading overlay
const _loEl = document.getElementById('loading-overlay');
if (_loEl) _loEl.style.display = 'flex';

// ── Data stores ──
let _allStations = [];
let _stateData = {};      // normName → { displayName, aqiSum, count, cityAvg }
let _citiesByState = {};  // normName → { cityName → { aqiSum, count, stations[] } }
let _selectedState = null; // normName of selected state
let _totalStations = null;
let _stateDomPaths = {};   // normName → SVG path element

// ── Render state fills ──
function renderStatePaths() {
  stateLayer.innerHTML = '';
  _stateDomPaths = {};
  Object.entries(STATE_IDS).forEach(([id, normName]) => {
    const d = statePaths[id];
    if (!d) return;
    const keys = id === 'jk' ? [normName, 'ladakh'] : [normName];
    const cityAvgs = keys.flatMap(k => _stateData[k]?.cityAvg != null ? [_stateData[k].cityAvg] : []);
    const stationSum = keys.reduce((s, k) => s + (_stateData[k]?.aqiSum || 0), 0);
    const cnt = keys.reduce((s, k) => s + (_stateData[k]?.count || 0), 0);
    const avg = cityAvgs.length
      ? Math.round(cityAvgs.reduce((a, b) => a + b, 0) / cityAvgs.length)
      : cnt ? Math.round(stationSum / cnt) : null;

    const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    el.setAttribute('d', d);
    el.setAttribute('class', 'state-path');
    el.setAttribute('fill', avg ? aqiColor(avg) : '#2A3D30');
    el.setAttribute('fill-opacity', avg ? '0.22' : '0.35');

    _stateDomPaths[normName] = el;
    if (id === 'jk' && _stateData['ladakh']) _stateDomPaths['ladakh'] = el;

    if (avg) {
      const dn = normName.replace(/\b\w/g, c => c.toUpperCase());
      el.addEventListener('mouseenter', e => {
        if (!el.classList.contains('state-selected')) el.setAttribute('fill-opacity', '0.42');
        showTip(e, `<strong>${dn}</strong> · ${aqiVerdict(avg)} · Avg AQI <strong style="color:${aqiTextColor(avg)}">${avg}</strong> · ${cnt} station${cnt > 1 ? 's' : ''}`);
      });
      el.addEventListener('mousemove', moveTip);
      el.addEventListener('mouseleave', () => {
        if (!el.classList.contains('state-selected')) el.setAttribute('fill-opacity', '0.22');
        hideTip();
      });
      el.style.cursor = 'pointer';
      el.addEventListener('click', () => {
        if (_selectedState === normName || (id === 'jk' && _selectedState === 'ladakh')) deselectState();
        else selectState(normName);
      });
    }
    stateLayer.appendChild(el);
  });
}

// ── Render state AQI bubbles ──
const SKIP_CODES = new Set(['an', 'ld', 'py']);
const MIN_STATE_AREA = 600;

function renderStateBubbles() {
  markerLayer.innerHTML = '';
  const displayW = mapWrap.getBoundingClientRect().width || 800;
  const pxPerUnit = displayW / SVG_W;

  Object.entries(_stateData).forEach(([normName, data]) => {
    const code = NORM_TO_CODE[normName];
    const svgC = code && STATE_SVG_CENTROIDS[code];
    if (!svgC || svgC.area < MIN_STATE_AREA || SKIP_CODES.has(code)) return;

    const avgAqi = data.cityAvg ?? Math.round(data.aqiSum / data.count);
    const cx = Math.max(35, Math.min(SVG_W - 35, svgC.cx));
    const cy = Math.max(55, Math.min(SVG_H - 35, svgC.cy));
    const rSvg = Math.max(14, Math.min(20, 16 + Math.log(Math.max(1, data.count)) * 1.2)) / pxPerUnit;

    const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
    g.setAttribute('transform', `translate(${cx.toFixed(1)},${cy.toFixed(1)})`);
    g.style.cursor = 'pointer';

    const outer = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    outer.setAttribute('cx', '0'); outer.setAttribute('cy', '0');
    outer.setAttribute('r', (rSvg * 1.5).toFixed(2));
    outer.setAttribute('fill', aqiColor(avgAqi));
    outer.setAttribute('class', 'cluster-outer');

    const inner = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    inner.setAttribute('cx', '0'); inner.setAttribute('cy', '0');
    inner.setAttribute('r', rSvg.toFixed(2));
    inner.setAttribute('fill', aqiColor(avgAqi));
    inner.setAttribute('class', 'cluster-inner');

    const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
    label.setAttribute('x', '0'); label.setAttribute('y', '0');
    label.setAttribute('class', 'cluster-label');
    label.style.fill = aqiLabelColor(aqiColor(avgAqi));
    label.setAttribute('font-size', (rSvg * pxPerUnit * 0.75 / pxPerUnit).toFixed(1));
    label.textContent = avgAqi;

    g.addEventListener('click', () => {
      if (_selectedState === normName) deselectState();
      else selectState(normName);
    });
    g.appendChild(outer); g.appendChild(inner); g.appendChild(label);
    markerLayer.appendChild(g);
  });
}

// ── State selection ──
function selectState(normName) {
  if (_selectedState && _stateDomPaths[_selectedState]) {
    _stateDomPaths[_selectedState].classList.remove('state-selected');
  }
  _selectedState = normName;
  if (_stateDomPaths[normName]) _stateDomPaths[normName].classList.add('state-selected');
  popup.style.display = 'none';
  renderPanel();
}

function deselectState() {
  if (_selectedState && _stateDomPaths[_selectedState]) {
    _stateDomPaths[_selectedState].classList.remove('state-selected');
  }
  _selectedState = null;
  popup.style.display = 'none';
  renderPanel();
}

// ── Panel rendering ──
function renderPanel() {
  if (_selectedState) renderStateCityView(_selectedState);
  else renderNationalView();
}

function renderNationalView() {
  panelBackBar.style.display = 'none';

  // Shared stats
  const allAqi = _allStations.map(s => s.aqi);
  const natAvg = allAqi.length ? Math.round(allAqi.reduce((a, b) => a + b, 0) / allAqi.length) : null;
  const times = _allStations.map(s => s.updated).filter(t => t && t !== 'demo').sort();
  const latestTime = times.length ? times[times.length - 1].match(/\d{1,2}:\d{2}/)?.[0] : null;
  const totalText = _totalStations && _totalStations > _allStations.length
    ? `${_allStations.length} of ${_totalStations} reporting`
    : `${_allStations.length} stations reporting`;

  // ── Zone 1: Hero card ──
  panelHero.innerHTML = `
    <div class="hero-card">
      <div class="hero-leaf">🍃</div>
      <div class="hero-title">India Air Quality</div>
      <div class="hero-subtitle-label">Live Air Quality Index (AQI)</div>
      <div class="hero-aqi-row">
        <span class="hero-num" style="color:${natAvg ? aqiTextColor(natAvg) : 'var(--text-muted)'}">${natAvg ?? '—'}</span>
        ${natAvg ? `<span class="hero-verdict-label" style="color:${aqiTextColor(natAvg)}">${aqiVerdict(natAvg)}</span>` : ''}
      </div>
      <div class="hero-meta">${totalText}${latestTime ? ` · As of ${latestTime}` : ''}</div>
    </div>`;

  // ── Zone 2: Category summary with bars ──
  const total = _allStations.length || 1;
  const bands = [
    [0,   50,   'Good',      '#55A84F'],
    [51,  100,  'Satisfact.','#A3C853'],
    [101, 200,  'Moderate',  '#FFF833'],
    [201, 300,  'Poor',      '#F29C33'],
    [301, 400,  'Very Poor', '#E93F33'],
    [401, 9999, 'Severe',    '#AF2D24'],
  ];
  let catHtml = '<div class="section-title">Category Summary</div>';
  bands.forEach(([lo, hi, label, color]) => {
    const n = _allStations.filter(s => s.aqi >= lo && s.aqi <= hi).length;
    const barW = Math.round(n / total * 100);
    catHtml += `
      <div class="cat-row">
        <span class="cat-dot" style="background:${color}"></span>
        <span class="cat-label">${label}</span>
        <div class="cat-bar-wrap"><div class="cat-bar" style="width:${barW}%;background:${color}"></div></div>
        <span class="cat-count">${n}</span>
      </div>`;
  });
  panelCategories.innerHTML = catHtml;

  // ── Zone 3: Top 5 + full list ──
  const states = Object.entries(_stateData)
    .map(([norm, d]) => ({ norm, name: d.displayName, avg: d.cityAvg ?? Math.round(d.aqiSum / d.count), count: d.count }))
    .sort((a, b) => b.avg - a.avg);

  const maxBar = Math.max(...states.map(s => s.avg), 400);
  let listHtml = '<div class="list-section-title">Top States by AQI</div>';
  states.slice(0, 5).forEach(st => {
    const bw = Math.round(st.avg / maxBar * 100);
    listHtml += `
      <div class="top5-row" data-norm="${st.norm}">
        <div class="top5-info">
          <span class="top5-name">${st.name}</span>
          <span class="top5-aqi" style="color:${aqiTextColor(st.avg)}">${st.avg}</span>
          <span class="top5-verdict">${aqiVerdict(st.avg)}</span>
        </div>
        <div class="top5-bar-wrap"><div class="top5-bar" style="width:${bw}%;background:${aqiColor(st.avg)}"></div></div>
      </div>`;
  });

  listHtml += '<div class="list-divider"><span>All States</span></div>';
  states.forEach(st => {
    listHtml += `
      <div class="panel-row" data-norm="${st.norm}">
        <span class="panel-dot" style="background:${aqiColor(st.avg)}"></span>
        <span class="panel-name">${st.name}</span>
        <span class="panel-aqi" style="color:${aqiTextColor(st.avg)}">${st.avg}</span>
        <span class="panel-verdict">${aqiVerdict(st.avg)}</span>
      </div>`;
  });

  panelList.innerHTML = listHtml;
  panelList.querySelectorAll('[data-norm]').forEach(row => {
    row.addEventListener('click', () => selectState(row.dataset.norm));
  });

  // Footer
  const pm25 = _allStations.filter(s => s.pollutant === 'PM2.5').length;
  const pm10 = _allStations.filter(s => s.pollutant === 'PM10').length;
  panelMeta.textContent = [
    totalText,
    pm25 || pm10 ? `PM2.5 ${pm25} · PM10 ${pm10}` : ''
  ].filter(Boolean).join(' · ');
}

function renderStateCityView(normName) {
  panelBackBar.style.display = 'block';
  panelCategories.innerHTML = '';

  const data = _stateData[normName];
  const displayName = data?.displayName || normName.replace(/\b\w/g, c => c.toUpperCase());
  const stateStations = _allStations.filter(s => normState(s.state) === normName);
  const stateAvg = data?.cityAvg ?? (stateStations.length
    ? Math.round(stateStations.reduce((a, s) => a + s.aqi, 0) / stateStations.length)
    : null);

  // ── Zone 1: State card ──
  panelHero.innerHTML = `
    <div class="state-card">
      <div class="state-card-name">${displayName}</div>
      <div class="state-card-aqi">
        <span class="state-card-num" style="color:${stateAvg ? aqiTextColor(stateAvg) : 'var(--text-muted)'}">${stateAvg ?? '—'}</span>
        ${stateAvg ? `<span class="state-card-verdict" style="color:${aqiTextColor(stateAvg)}">${aqiVerdict(stateAvg)}</span>` : ''}
      </div>
      <div class="state-card-meta">${stateStations.length} monitoring stations</div>
    </div>`;

  // ── Zone 3: City list ──
  const cityMap = _citiesByState[normName] || {};
  const cities = Object.entries(cityMap)
    .map(([city, d]) => ({ city, avg: Math.round(d.aqiSum / d.count), count: d.count, stations: d.stations }))
    .sort((a, b) => b.avg - a.avg);

  let listHtml = '<div class="list-section-title">Cities by AQI</div>';
  cities.forEach(c => {
    listHtml += `
      <div class="panel-row city-row" data-city="${c.city}">
        <span class="panel-dot" style="background:${aqiColor(c.avg)}"></span>
        <span class="panel-name">${c.city}</span>
        <span class="panel-aqi" style="color:${aqiTextColor(c.avg)}">${c.avg}</span>
        <span class="panel-verdict">${aqiVerdict(c.avg)} · ${c.count} stn</span>
      </div>`;
  });

  panelList.innerHTML = listHtml;
  cities.forEach(c => {
    const row = panelList.querySelector(`[data-city="${CSS.escape(c.city)}"]`);
    if (row) row.addEventListener('click', () => {
      const best = [...c.stations].sort((a, b) => b.aqi - a.aqi)[0];
      if (best) showPopup(best);
    });
  });

  panelMeta.textContent = `${stateStations.length} monitoring station${stateStations.length !== 1 ? 's' : ''}`;
}

// ── Station popup ──
function svgToScreen(sx, sy) {
  const pt = svgEl.createSVGPoint(); pt.x = sx; pt.y = sy;
  const s = pt.matrixTransform(svgEl.getScreenCTM());
  return [s.x, s.y];
}
function showPopup(s) {
  const [sx, sy] = project(s.lat, s.lng);
  const [px, py] = svgToScreen(sx, sy);
  popup.style.left = `${px}px`; popup.style.top = `${py}px`; popup.style.display = 'block';
  const minMax = (isFinite(s.min) && isFinite(s.max))
    ? `<span style="font-size:11px;color:var(--text-muted)"> · Range: ${s.min}–${s.max}</span>` : '';
  const isModel = s.source === 'open-meteo' || s.updated === 'model';
  const updTime = !isModel && s.updated && s.updated !== 'demo'
    ? s.updated.match(/\d{1,2}:\d{2}/)?.[0] ?? '' : '';
  const sourceTag = s.source === 'open-meteo'
    ? `<span style="font-size:10px;background:var(--surface-2);border:1px solid var(--border);border-radius:4px;padding:1px 6px;margin-left:4px;color:var(--text-muted)">CAMS model</span>` : '';
  const oaqTag = s.source === 'openaq'
    ? `<span style="font-size:10px;background:var(--surface-2);border:1px solid var(--border);border-radius:4px;padding:1px 6px;margin-left:4px;color:var(--text-muted)">OpenAQ</span>` : '';
  popupInner.innerHTML = `<button id="popup-close">×</button>
    <strong>${s.station}</strong>${sourceTag}${oaqTag}<br>
    <span style="color:var(--text-muted)">${s.city}${s.state && s.state !== s.city ? ', ' + s.state : ''}</span><br><br>
    AQI <strong style="font-size:20px;color:${aqiColor(s.aqi)}">${s.aqi}</strong>
    <span style="color:var(--text-muted)"> · ${aqiVerdict(s.aqi)}</span>${minMax}<br>
    <span style="font-size:11px;color:var(--text-muted)">${s.pollutant}${isModel ? ' · Atmospheric model estimate' : updTime ? ' · Updated ' + updTime : ''}</span>`;
  document.getElementById('popup-close').onclick = () => popup.style.display = 'none';
}
mapWrap.addEventListener('click', () => popup.style.display = 'none');

// ── State hover tooltip ──
function showTip(e, html) { stateTip.innerHTML = html; stateTip.style.display = 'block'; moveTip(e); }
function moveTip(e) {
  stateTip.style.left = `${Math.min(e.clientX + 12, innerWidth - stateTip.offsetWidth - 8)}px`;
  stateTip.style.top  = `${Math.min(e.clientY + 12, innerHeight - stateTip.offsetHeight - 8)}px`;
}
function hideTip() { stateTip.style.display = 'none'; }

// ── Panel back button ──
panelBack.addEventListener('click', deselectState);

// ── Resize ──
window.addEventListener('resize', () => { if (_allStations.length) renderStateBubbles(); });

// ── Main entry ──
function renderMarkers(stations) {
  _allStations = stations;
  _stateData = {};
  _citiesByState = {};

  stations.forEach(s => {
    if (!s.state) return;
    const k = normState(s.state);
    if (!_stateData[k]) _stateData[k] = { displayName: s.state, aqiSum: 0, count: 0 };
    _stateData[k].aqiSum += s.aqi;
    _stateData[k].count++;

    if (s.city) {
      if (!_citiesByState[k]) _citiesByState[k] = {};
      const cb = _citiesByState[k];
      if (!cb[s.city]) cb[s.city] = { aqiSum: 0, count: 0, stations: [] };
      cb[s.city].aqiSum += s.aqi;
      cb[s.city].count++;
      cb[s.city].stations.push(s);
    }
  });

  // AQI-proportional weighted average per state: worse cities count more
  Object.entries(_stateData).forEach(([normName, data]) => {
    const cities = _citiesByState[normName] || {};
    const cityAvgs = Object.values(cities).map(d => d.aqiSum / d.count);
    if (cityAvgs.length) {
      const sumSq = cityAvgs.reduce((a, v) => a + v * v, 0);
      const sumV  = cityAvgs.reduce((a, v) => a + v, 0);
      data.cityAvg = sumV > 0 ? Math.round(sumSq / sumV) : Math.round(data.aqiSum / data.count);
    } else {
      data.cityAvg = Math.round(data.aqiSum / data.count);
    }
  });

  renderStatePaths();
  renderStateBubbles();
  renderPanel();
}

function updateStats(stations, total = null) {
  _totalStations = total;
  renderPanel();
}

function showBanner(msg) {
  if (!bannerEl) return;
  bannerEl.textContent = msg; bannerEl.style.display = 'block';
  setTimeout(() => bannerEl.style.display = 'none', 6000);
}

// ── Pollutants view ──
function renderPollutantsView() {
  const polls = document.getElementById('panel-pollutants');
  if (!polls) return;
  if (!_allStations.length) {
    polls.innerHTML = '<p style="padding:20px 16px;font-size:12px;color:var(--text-muted)">Loading data…</p>';
    return;
  }

  const pm25stns = _allStations.filter(s => s.pollutant === 'PM2.5');
  const pm10stns = _allStations.filter(s => s.pollutant === 'PM10');
  const total = _allStations.length;

  // City-level averages per pollutant
  function cityAvgs(stns) {
    const m = {};
    stns.forEach(s => {
      if (!s.city) return;
      if (!m[s.city]) m[s.city] = { aqiSum: 0, count: 0, state: s.state };
      m[s.city].aqiSum += s.aqi; m[s.city].count++;
    });
    return Object.entries(m)
      .map(([city, d]) => ({ city, avg: Math.round(d.aqiSum / d.count), state: d.state }))
      .sort((a, b) => b.avg - a.avg);
  }

  const topPM25 = cityAvgs(pm25stns).slice(0, 8);
  const topPM10 = cityAvgs(pm10stns).slice(0, 8);

  function cityRows(list, tag) {
    return list.map(c => `
      <div class="panel-row">
        <span class="panel-dot" style="background:${aqiColor(c.avg)}"></span>
        <span class="panel-name">${c.city}<span class="poll-tag" style="background:${aqiColor(c.avg)};color:${aqiLabelColor(aqiColor(c.avg))}">${tag}</span></span>
        <span class="panel-aqi" style="color:${aqiTextColor(c.avg)}">${c.avg}</span>
        <span class="panel-verdict">${aqiVerdict(c.avg)}</span>
      </div>`).join('');
  }

  polls.innerHTML = `
    <div class="poll-coverage">
      <div class="poll-coverage-title">Pollutant Coverage</div>
      <div class="poll-coverage-sub">Stations monitoring today</div>
      <div class="poll-split">
        <div class="poll-block">
          <div class="poll-num">${pm25stns.length}</div>
          <div class="poll-lbl">PM2.5 stations</div>
          <div class="poll-pct">${Math.round(pm25stns.length / total * 100)}%</div>
        </div>
        <div class="poll-divider"></div>
        <div class="poll-block">
          <div class="poll-num">${pm10stns.length}</div>
          <div class="poll-lbl">PM10 stations</div>
          <div class="poll-pct">${Math.round(pm10stns.length / total * 100)}%</div>
        </div>
      </div>
    </div>
    <div class="poll-section-title">Worst PM2.5 Cities</div>
    ${cityRows(topPM25, 'PM2.5')}
    <div class="poll-section-title" style="margin-top:4px">Worst PM10 Cities</div>
    ${cityRows(topPM10, 'PM10')}`;
}

// ── Panel tab switching ──
document.querySelectorAll('.ptab').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.ptab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const tab = btn.dataset.tab;
    const viewOverview = document.getElementById('view-overview');
    const viewPollutants = document.getElementById('view-pollutants');
    if (viewOverview) viewOverview.style.display = tab === 'overview' ? '' : 'none';
    if (viewPollutants) viewPollutants.style.display = tab === 'pollutants' ? '' : 'none';
    if (tab === 'pollutants') {
      if (_selectedState) deselectState();
      renderPollutantsView();
    }
  });
});

// ── Export API ──
const __api = {
  renderMarkers, updateStats, showBanner, project,
  hideLoading: () => {
    const el = document.getElementById('loading-overlay');
    if (el) el.style.display = 'none';
  }
};
window.__vatavaran = __api;
try { document.dispatchEvent(new CustomEvent('mapready', { detail: __api })); }
catch(e) { console.error('[IndiaMap] mapready:', e); }
</script>
