---
interface Props { title: string; activeTab: string; }
const { title, activeTab } = Astro.props;
const base = import.meta.env.BASE_URL;
const themes: Record<string, Record<string, string>> = {
  vayu: {},
  jal:  { '--accent':'#29B6F6','--surface':'#0F2030','--surface-2':'#1A3448','--border':'#1E4060','--text-muted':'#5A9BB5','--bg':'#080F15' },
  agni: { '--accent':'#FF7043','--surface':'#2E1510','--surface-2':'#3E2018','--border':'#4A2D18','--text-muted':'#B07050','--bg':'#0F0805' },
};
const themeOverrides = themes[activeTab] || {};
const themeCSS = Object.entries(themeOverrides).map(([k,v])=>`${k}:${v}`).join(';');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
  {themeCSS && <style set:html={`:root{${themeCSS}}`} />}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0A0F0D; --surface: #1A2E1F; --surface-2: #243828;
      --border: #2D4A32; --text: #E8F5E0; --text-muted: #7DA882; --accent: #4CAF50;
      --nav-h: 56px; --stats-h: 44px; --panel-collapsed: 40px; --panel-expanded: 280px;
    }
    html, body { height: 100%; background: var(--bg); color: var(--text);
      font-family: 'Space Grotesk', sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden; }
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 200; height: var(--nav-h);
      background: rgba(10,15,13,0.92); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between; padding: 0 20px;
    }
    .wordmark { font-size: 18px; font-weight: 600; letter-spacing: -0.5px; color: var(--text); text-decoration: none; }
    .wordmark span { color: var(--accent); }
    .tabs { display: flex; gap: 4px; }
    .tabs a { font-size: 13px; font-weight: 500; text-decoration: none; padding: 6px 14px;
      border-radius: 20px; transition: background .15s, color .15s; color: var(--text-muted); }
    .tabs a.active { background: var(--surface-2); color: var(--text); border: 1px solid var(--border); }
    .tabs a:not(.active):hover { color: var(--text); }
    .tabs a.dimmed { opacity: .45; cursor: default; pointer-events: none; }
    #stats-bar {
      position: fixed; top: var(--nav-h); left: 0; right: 0; z-index: 190; height: var(--stats-h);
      display: flex; align-items: center; justify-content: center; gap: 10px;
    }
    .stat-pill {
      background: var(--surface); border: 1px solid var(--border); border-radius: 20px;
      padding: 6px 14px; font-size: 13px; font-weight: 500; display: flex; align-items: center; gap: 6px;
    }
    .stat-pill .val { font-family: 'JetBrains Mono', monospace; font-weight: 700; }
    #map-wrap {
      position: fixed; top: calc(var(--nav-h) + var(--stats-h)); left: var(--panel-collapsed);
      right: 0; bottom: 0; overflow: hidden; cursor: grab; background: var(--bg);
    }
    #map-wrap:active { cursor: grabbing; }
    #india-svg { width: 100%; height: 100%; display: block; }
    .state-path { stroke: #2D4A32; stroke-width: 0.8; stroke-opacity: 0.7; transition: fill-opacity .12s; }
    .station-dot { r: var(--dot-r, 6); stroke: rgba(255,255,255,.25); stroke-width: 1.5; cursor: pointer; fill-opacity: .92; }
    .station-label { display: none; font-size: var(--label-fs, 7px); fill: var(--text); fill-opacity: .88;
      font-family: 'Space Grotesk', sans-serif; font-weight: 500; pointer-events: none; }
    #india-svg.detail-mode .station-label { display: block; }
    .cluster-outer { fill-opacity: .3; cursor: pointer; }
    .cluster-inner { fill-opacity: .85; cursor: pointer; stroke: rgba(255,255,255,.3); stroke-width: 1; }
    .cluster-label { fill: #fff; font-family: 'JetBrains Mono', monospace; font-weight: 700;
      text-anchor: middle; dominant-baseline: central; pointer-events: none; }
    #zoom-btns { position: fixed; bottom: 24px; right: 24px; z-index: 150; display: flex; flex-direction: column; gap: 4px; }
    .zoom-btn { width: 36px; height: 36px; background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; color: var(--text); font-size: 20px; cursor: pointer; display: flex;
      align-items: center; justify-content: center; transition: background .15s; }
    .zoom-btn:hover { background: var(--surface-2); }
    #popup { position: fixed; z-index: 300; display: none; min-width: 220px; max-width: 300px; pointer-events: none; }
    #popup-inner { background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
      padding: 14px 16px; font-size: 13px; line-height: 1.6; pointer-events: auto; }
    #popup-inner strong { font-family: 'JetBrains Mono', monospace; font-size: 15px; }
    #popup-close { float: right; background: none; border: none; color: var(--text-muted);
      cursor: pointer; font-size: 16px; padding: 0; line-height: 1; }
    #state-tip { position: fixed; z-index: 400; display: none; background: rgba(10,15,13,.95);
      border: 1px solid var(--border); border-radius: 8px; padding: 8px 12px;
      font-size: 12px; pointer-events: none; max-width: 220px; }
    #legend { position: fixed; bottom: 24px; right: 72px; z-index: 150;
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
    #legend h4 { font-size: 10px; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; }
    .legend-row { display: flex; align-items: center; gap: 8px; font-size: 12px; margin-bottom: 4px; }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
    .legend-soi { font-size: 10px; color: var(--text-muted); margin-top: 8px; line-height: 1.4; border-top: 1px solid var(--border); padding-top: 6px; max-width: 180px; }
    #filter-panel {
      position: fixed; top: calc(var(--nav-h) + var(--stats-h)); left: 0; bottom: 0; z-index: 180;
      width: var(--panel-collapsed); transition: width .2s; background: var(--surface);
      border-right: 1px solid var(--border); overflow: hidden;
    }
    #filter-panel.expanded { width: var(--panel-expanded); }
    #filter-strip { width: var(--panel-collapsed); height: 100%; display: flex; align-items: center;
      justify-content: center; cursor: pointer; flex-direction: column; gap: 8px; flex-shrink: 0; }
    #filter-strip span { writing-mode: vertical-rl; font-size: 10px; letter-spacing: 2px;
      color: var(--text-muted); text-transform: uppercase; }
    #filter-content { position: absolute; left: var(--panel-collapsed); top: 0; bottom: 0;
      width: calc(var(--panel-expanded) - var(--panel-collapsed)); padding: 20px 16px;
      display: flex; flex-direction: column; gap: 14px; overflow-y: auto; }
    #filter-content h3 { font-size: 13px; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; }
    #filter-content select { width: 100%; background: var(--surface-2); border: 1px solid var(--border);
      border-radius: 8px; color: var(--text); padding: 8px 10px; font-size: 13px;
      font-family: inherit; cursor: pointer; }
    #filter-reset { background: none; border: 1px solid var(--border); border-radius: 8px;
      color: var(--text-muted); padding: 8px; font-size: 12px; cursor: pointer;
      width: 100%; transition: color .15s; }
    #filter-reset:hover { color: var(--text); }
    #loading-overlay { position: fixed; inset: 0; background: var(--bg); z-index: 500;
      display: none; align-items: center; justify-content: center; flex-direction: column; gap: 12px; }
    .spinner { width: 32px; height: 32px; border: 3px solid var(--border);
      border-top-color: var(--accent); border-radius: 50%; animation: spin .8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    #banner { position: fixed; top: calc(var(--nav-h) + var(--stats-h) + 8px); left: 50%;
      transform: translateX(-50%); z-index: 350; background: var(--surface-2);
      border: 1px solid var(--border); border-radius: 8px; padding: 8px 16px;
      font-size: 12px; display: none; max-width: 480px; text-align: center; }
  </style>
</head>
<body>
<nav>
  <a class="wordmark" href={base + '/'}>वाता<span>वरण</span></a>
  <div class="tabs">
    <a href={base + '/vayu/'} class={activeTab==='vayu' ? 'active' : ''}>vayu</a>
    <a href={base + '/agni/'} class={activeTab==='agni' ? 'active dimmed' : 'dimmed'}>agni</a>
    <a href={base + '/jal/'}  class={activeTab==='jal'  ? 'active dimmed' : 'dimmed'}>jal</a>
  </div>
</nav>
<div id="stats-bar">
  <div class="stat-pill"><span id="stat-count" class="val">—</span><span id="stat-of-total" style="color:var(--text-muted)"></span> reporting</div>
  <div class="stat-pill">Worst: <span id="stat-worst" class="val" style="color:#E93F33">—</span></div>
  <div class="stat-pill">Best: <span id="stat-best" class="val" style="color:#55A84F">—</span></div>
</div>
<div id="loading-overlay"><div class="spinner"></div><span>Loading data…</span></div>
<div id="banner"></div>
<script>setTimeout(function(){var e=document.getElementById('loading-overlay');if(e)e.style.display='none';},20000);</script>
<slot />
</body>
</html>
